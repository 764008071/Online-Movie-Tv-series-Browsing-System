<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

     <servlet>
     	<servlet-name>MGRInsertServlet</servlet-name>
     	<servlet-class>Moviehubpackage.MGRInsertServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
     	<servlet-name>MGRInsertServlet</servlet-name>
     	<url-pattern>/MGRInsertServlet</url-pattern>
     </servlet-mapping>
     
     <servlet>
     	<servlet-name>MGRGetAllServlet</servlet-name>
     	<servlet-class>Moviehubpackage.MGRGetAllServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
     	<servlet-name>MGRGetAllServlet</servlet-name>
     	<url-pattern>/MGRGetAllServlet</url-pattern>
     </servlet-mapping>
     
     <servlet>
     	<servlet-name>MGRUpdateServlet</servlet-name>
     	<servlet-class>Moviehubpackage.MGRUpdateServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
     	<servlet-name>MGRUpdateServlet</servlet-name>
     	<url-pattern>/MGRUpdateServlet</url-pattern>
     </servlet-mapping>
     
     <servlet>
     	<servlet-name>MGRDeleteServlet</servlet-name>
     	<servlet-class>Moviehubpackage.MGRDeleteServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
     	<servlet-name>MGRDeleteServlet</servlet-name>
     	<url-pattern>/MGRDeleteServlet</url-pattern>
     </servlet-mapping>
     

</web-app>

